    "source": "namespace Framework.Parameters\r\n{\r\n    /// <summary>\r\n    /// パラメーターに適用する補正方法を定義する。\r\n    /// </summary>\r\n    public enum ParameterModifierType\r\n    {\r\n        /// <summary>\r\n        /// 基本値に指定された数値を加算する。\r\n        /// 負数を指定した場合は減算となる。\r\n        /// </summary>\r\n        Additive = 0,\r\n\r\n        /// <summary>\r\n        /// 加算補正後の値に指定された倍率を乗算する。\r\n        /// 1は変化なし、0は値を0にする補正を表す。\r\n        /// </summary>\r\n        Multiplicative = 1\r\n    }\r\n}",
