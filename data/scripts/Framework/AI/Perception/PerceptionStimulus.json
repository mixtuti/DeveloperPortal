    "source": "\r\nusing System;\r\n\r\nnamespace Framework.AI.Perception\r\n{\r\n    /// <summary>\r\n    /// エージェントが認識した刺激の情報を保持する。\r\n    /// </summary>\r\n    /// <typeparam name=\"TPosition\">\r\n    /// 認識位置を表現する型。\r\n    /// </typeparam>\r\n    /// <remarks>\r\n    /// 認識時点の情報を保持する。\r\n    /// 対象の現在位置を自動的に追跡するものではない。\r\n    /// </remarks>\r\n    public readonly struct PerceptionStimulus<TPosition>\r\n    {\r\n        /// <summary>\r\n        /// 認識した対象の識別子。\r\n        /// 対象不明の場合はGuid.Emptyを使用する。\r\n        /// </summary>\r\n        public Guid SourceId { get; }\r\n\r\n        /// <summary>\r\n        /// 情報を認識した手段。\r\n        /// </summary>\r\n        public PerceptionType Type { get; }\r\n\r\n        /// <summary>\r\n        /// 認識時点における対象の位置。\r\n        /// </summary>\r\n        public TPosition Position { get; }\r\n\r\n        /// <summary>\r\n        /// 認識情報の信頼度。0から1の範囲。\r\n        /// </summary>\r\n        public float Confidence { get; }\r\n\r\n        /// <summary>\r\n        /// 情報を認識した時刻。単位は秒。\r\n        /// </summary>\r\n        public double Timestamp { get; }\r\n\r\n        /// <summary>\r\n        /// 正常に生成された認識情報かどうか。\r\n        /// </summary>\r\n        public bool IsValid { get; }\r\n\r\n        /// <summary>\r\n        /// 認識した刺激の情報を生成する。\r\n        /// </summary>\r\n        /// <param name=\"sourceId\">認識対象の識別子</param>\r\n        /// <param name=\"type\">認識手段</param>\r\n        /// <param name=\"position\">認識位置</param>\r\n        /// <param name=\"confidence\">信頼度。0から1</param>\r\n        /// <param name=\"timestamp\">認識時刻。単位は秒</param>\r\n        /// <exception cref=\"ArgumentOutOfRangeException\">\r\n        /// 認識手段、信頼度、認識時刻が不正な場合に発生する。\r\n        /// </exception>\r\n        /// <exception cref=\"ArgumentNullException\">\r\n        /// 認識位置がnullの場合に発生する。\r\n        /// </exception>\r\n        public PerceptionStimulus(\r\n            Guid sourceId,\r\n            PerceptionType type,\r\n            TPosition position,\r\n            float confidence,\r\n            double timestamp)\r\n        {\r\n            if (type != PerceptionType.Sight &&\r\n                type != PerceptionType.Hearing &&\r\n                type != PerceptionType.Contact &&\r\n                type != PerceptionType.External)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(type));\r\n            }\r\n\r\n            if (position is null)\r\n            {\r\n                throw new ArgumentNullException(\r\n                    nameof(position));\r\n            }\r\n\r\n            if (float.IsNaN(confidence) ||\r\n                float.IsInfinity(confidence) ||\r\n                confidence < 0f ||\r\n                confidence > 1f)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(confidence));\r\n            }\r\n\r\n            if (double.IsNaN(timestamp) ||\r\n                double.IsInfinity(timestamp) ||\r\n                timestamp < 0d)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(timestamp));\r\n            }\r\n\r\n            SourceId = sourceId;\r\n            Type = type;\r\n            Position = position;\r\n            Confidence = confidence;\r\n            Timestamp = timestamp;\r\n            IsValid = true;\r\n        }\r\n    }\r\n}\r\n",
