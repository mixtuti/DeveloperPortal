    "source": "\r\nnamespace Framework.AI.Actions\r\n{\r\n    /// <summary>\r\n    /// エージェントが実行する行動の共通インターフェース。\r\n    /// </summary>\r\n    /// <typeparam name=\"TAction\">行動識別子の型</typeparam>\r\n    /// <typeparam name=\"TContext\">行動実行情報の型</typeparam>\r\n    /// <remarks>\r\n    /// 内部状態を持つ行動インスタンスは\r\n    /// エージェントごとに生成する。\r\n    /// </remarks>\r\n    public interface IAgentAction<TAction, TContext>\r\n    {\r\n        /// <summary>\r\n        /// 行動の識別子を取得する。\r\n        /// </summary>\r\n        TAction Id { get; }\r\n\r\n        /// <summary>\r\n        /// 行動実行設定を取得する。\r\n        /// </summary>\r\n        AgentActionSettings Settings { get; }\r\n\r\n        /// <summary>\r\n        /// 現在の状況で行動を開始できるか判定する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動実行情報</param>\r\n        /// <returns>開始可能な場合はtrue</returns>\r\n        bool CanEnter(TContext context);\r\n\r\n        /// <summary>\r\n        /// 行動開始時の初期化処理を実行する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動実行情報</param>\r\n        void Enter(TContext context);\r\n\r\n        /// <summary>\r\n        /// 実行中の行動を更新する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動実行情報</param>\r\n        /// <param name=\"deltaTime\">前回更新からの経過秒数</param>\r\n        /// <returns>行動の更新結果</returns>\r\n        AgentActionStatus Tick(\r\n            TContext context,\r\n            float deltaTime);\r\n\r\n        /// <summary>\r\n        /// 行動終了時の後処理を実行する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動実行情報</param>\r\n        /// <param name=\"reason\">行動の終了理由</param>\r\n        void Exit(\r\n            TContext context,\r\n            AgentActionExitReason reason);\r\n    }\r\n}\r\n",
