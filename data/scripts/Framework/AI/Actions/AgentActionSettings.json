    "source": "\r\nusing System;\r\n\r\nnamespace Framework.AI.Actions\r\n{\r\n    /// <summary>\r\n    /// エージェントの行動実行に関する設定を保持する。\r\n    /// </summary>\r\n    public sealed class AgentActionSettings\r\n    {\r\n        /// <summary>\r\n        /// 行動を切り替えられるまでの最低継続時間。\r\n        /// 単位は秒。\r\n        /// </summary>\r\n        public float MinimumDuration { get; }\r\n\r\n        /// <summary>\r\n        /// 行動終了後に再実行できるまでの時間。\r\n        /// 単位は秒。\r\n        /// </summary>\r\n        public float Cooldown { get; }\r\n\r\n        /// <summary>\r\n        /// 通常の行動切り替えによる中断を許可するか。\r\n        /// </summary>\r\n        public bool CanInterrupt { get; }\r\n\r\n        /// <summary>\r\n        /// 行動実行設定を生成する。\r\n        /// </summary>\r\n        /// <param name=\"minimumDuration\">最低継続時間。秒</param>\r\n        /// <param name=\"cooldown\">クールダウン時間。秒</param>\r\n        /// <param name=\"canInterrupt\">通常中断を許可するか</param>\r\n        public AgentActionSettings(\r\n            float minimumDuration = 0f,\r\n            float cooldown = 0f,\r\n            bool canInterrupt = true)\r\n        {\r\n            ValidateDuration(\r\n                minimumDuration,\r\n                nameof(minimumDuration));\r\n\r\n            ValidateDuration(\r\n                cooldown,\r\n                nameof(cooldown));\r\n\r\n            MinimumDuration = minimumDuration;\r\n            Cooldown = cooldown;\r\n            CanInterrupt = canInterrupt;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 時間設定が有限の非負数であることを検証する。\r\n        /// </summary>\r\n        /// <param name=\"value\">検証する時間</param>\r\n        /// <param name=\"parameterName\">引数名</param>\r\n        /// <exception cref=\"ArgumentOutOfRangeException\">\r\n        /// 時間設定が不正な場合に発生する。\r\n        /// </exception>\r\n        private static void ValidateDuration(\r\n            float value,\r\n            string parameterName)\r\n        {\r\n            if (float.IsNaN(value) ||\r\n                float.IsInfinity(value) ||\r\n                value < 0f)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    parameterName);\r\n            }\r\n        }\r\n    }\r\n}\r\n",
