    "source": "\r\nusing System;\r\nusing UnityEngine;\r\n\r\nnamespace Framework.AI.Scheduling\r\n{\r\n    /// <summary>\r\n    /// エージェントの間隔更新と負荷分散に関する設定。\r\n    /// </summary>\r\n    [Serializable]\r\n    public sealed class AgentUpdateSettings\r\n    {\r\n        [Header(\"更新設定\")]\r\n        [SerializeField]\r\n        [Min(0.001f)]\r\n        [Tooltip(\"エージェントの標準更新間隔。単位は秒。\")]\r\n        private float updateInterval = 0.2f;\r\n\r\n        [SerializeField]\r\n        [Min(1)]\r\n        [Tooltip(\"1回の管理更新で実行可能な最大エージェント数。\")]\r\n        private int maxUpdatesPerTick = 8;\r\n\r\n        [SerializeField]\r\n        [Tooltip(\"登録時の初回更新タイミングを分散する。\")]\r\n        private bool staggerInitialUpdate = true;\r\n\r\n        [SerializeField]\r\n        [Tooltip(\"Time.timeScaleの影響を受けない時間を使用する。\")]\r\n        private bool useUnscaledTime = false;\r\n\r\n        /// <summary>\r\n        /// 標準更新間隔を取得する。単位は秒。\r\n        /// </summary>\r\n        public float UpdateInterval => updateInterval;\r\n\r\n        /// <summary>\r\n        /// 1回の管理更新における最大実行件数を取得する。\r\n        /// </summary>\r\n        public int MaxUpdatesPerTick => maxUpdatesPerTick;\r\n\r\n        /// <summary>\r\n        /// 初回更新タイミングを分散するか取得する。\r\n        /// </summary>\r\n        public bool StaggerInitialUpdate =>\r\n            staggerInitialUpdate;\r\n\r\n        /// <summary>\r\n        /// 非スケール時間を使用するか取得する。\r\n        /// </summary>\r\n        public bool UseUnscaledTime => useUnscaledTime;\r\n\r\n        /// <summary>\r\n        /// 標準設定を生成する。\r\n        /// </summary>\r\n        public AgentUpdateSettings()\r\n        {\r\n        }\r\n\r\n        /// <summary>\r\n        /// 指定された設定値を使用して生成する。\r\n        /// </summary>\r\n        /// <param name=\"updateInterval\">更新間隔。単位は秒</param>\r\n        /// <param name=\"maxUpdatesPerTick\">最大実行件数</param>\r\n        /// <param name=\"staggerInitialUpdate\">初回更新の分散設定</param>\r\n        /// <param name=\"useUnscaledTime\">非スケール時間の使用設定</param>\r\n        public AgentUpdateSettings(\r\n            float updateInterval,\r\n            int maxUpdatesPerTick,\r\n            bool staggerInitialUpdate = true,\r\n            bool useUnscaledTime = false)\r\n        {\r\n            this.updateInterval = updateInterval;\r\n            this.maxUpdatesPerTick = maxUpdatesPerTick;\r\n            this.staggerInitialUpdate = staggerInitialUpdate;\r\n            this.useUnscaledTime = useUnscaledTime;\r\n\r\n            Validate();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 設定値が有効であることを検証する。\r\n        /// </summary>\r\n        /// <exception cref=\"ArgumentOutOfRangeException\">\r\n        /// 更新間隔または最大実行件数が不正な場合に発生する。\r\n        /// </exception>\r\n        public void Validate()\r\n        {\r\n            if (float.IsNaN(updateInterval) ||\r\n                float.IsInfinity(updateInterval) ||\r\n                updateInterval < 0.001f)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(updateInterval),\r\n                    \"更新間隔は0.001秒以上である必要があります。\");\r\n            }\r\n\r\n            if (maxUpdatesPerTick < 1)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(maxUpdatesPerTick),\r\n                    \"最大実行件数は1以上である必要があります。\");\r\n            }\r\n        }\r\n    }\r\n}\r\n",
