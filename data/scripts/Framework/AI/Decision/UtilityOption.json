    "source": "\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.Collections.ObjectModel;\r\n\r\nnamespace Framework.AI.Decision\r\n{\r\n    /// <summary>\r\n    /// Utility AIにおける行動候補を定義する。\r\n    /// </summary>\r\n    /// <typeparam name=\"TAction\">行動識別子の型</typeparam>\r\n    /// <typeparam name=\"TContext\">意思決定情報の型</typeparam>\r\n    /// <remarks>\r\n    /// 行動の評価のみを担当し、実際の行動は実行しない。\r\n    /// 評価処理が状態を変更しないことを前提とする。\r\n    /// </remarks>\r\n    public sealed class UtilityOption<TAction, TContext>\r\n    {\r\n        /// <summary>\r\n        /// 行動候補を利用できるか判定する処理。\r\n        /// </summary>\r\n        private readonly Func<TContext, bool> availability;\r\n\r\n        /// <summary>\r\n        /// 行動候補に登録された評価要素。\r\n        /// </summary>\r\n        private readonly UtilityConsideration<TContext>[]\r\n            considerations;\r\n\r\n        /// <summary>\r\n        /// 評価要素の読み取り専用コレクション。\r\n        /// </summary>\r\n        private readonly ReadOnlyCollection<\r\n            UtilityConsideration<TContext>> readOnlyConsiderations;\r\n\r\n        /// <summary>\r\n        /// 行動候補の識別子を取得する。\r\n        /// </summary>\r\n        public TAction Id { get; }\r\n\r\n        /// <summary>\r\n        /// 行動候補の基本重みを取得する。\r\n        /// </summary>\r\n        public float Weight { get; }\r\n\r\n        /// <summary>\r\n        /// 評価要素数による補正を使用するか取得する。\r\n        /// </summary>\r\n        public bool UseCompensation { get; }\r\n\r\n        /// <summary>\r\n        /// 登録されている評価要素を取得する。\r\n        /// </summary>\r\n        public IReadOnlyList<UtilityConsideration<TContext>>\r\n            Considerations => readOnlyConsiderations;\r\n\r\n        /// <summary>\r\n        /// 行動候補を生成する。\r\n        /// </summary>\r\n        /// <param name=\"id\">行動識別子</param>\r\n        /// <param name=\"considerations\">評価要素の一覧</param>\r\n        /// <param name=\"weight\">基本重み。0から1</param>\r\n        /// <param name=\"useCompensation\">補正を使用するか</param>\r\n        /// <param name=\"availability\">\r\n        /// 行動を利用できるか判定する処理。\r\n        /// nullの場合は常に利用可能とする。\r\n        /// </param>\r\n        public UtilityOption(\r\n            TAction id,\r\n            IEnumerable<UtilityConsideration<TContext>>\r\n                considerations,\r\n            float weight = 1f,\r\n            bool useCompensation = true,\r\n            Func<TContext, bool> availability = null)\r\n        {\r\n            if (id is null)\r\n            {\r\n                throw new ArgumentNullException(nameof(id));\r\n            }\r\n\r\n            if (considerations == null)\r\n            {\r\n                throw new ArgumentNullException(\r\n                    nameof(considerations));\r\n            }\r\n\r\n            if (float.IsNaN(weight) ||\r\n                float.IsInfinity(weight) ||\r\n                weight < 0f ||\r\n                weight > 1f)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(weight));\r\n            }\r\n\r\n            // 呼び出し元のコレクション変更による影響を防ぐ。\r\n            var buffer =\r\n                new List<UtilityConsideration<TContext>>();\r\n\r\n            foreach (var consideration in considerations)\r\n            {\r\n                if (consideration == null)\r\n                {\r\n                    throw new ArgumentException(\r\n                        \"評価要素にnullが含まれています。\",\r\n                        nameof(considerations));\r\n                }\r\n\r\n                buffer.Add(consideration);\r\n            }\r\n\r\n            Id = id;\r\n            Weight = weight;\r\n            UseCompensation = useCompensation;\r\n\r\n            this.availability = availability;\r\n            this.considerations = buffer.ToArray();\r\n\r\n            readOnlyConsiderations =\r\n                Array.AsReadOnly(this.considerations);\r\n        }\r\n\r\n        /// <summary>\r\n        /// 行動候補が利用可能か判定する。\r\n        /// </summary>\r\n        /// <param name=\"context\">意思決定情報</param>\r\n        /// <returns>利用可能な場合はtrue</returns>\r\n        public bool IsAvailable(TContext context)\r\n        {\r\n            return availability == null ||\r\n                   availability(context);\r\n        }\r\n\r\n        /// <summary>\r\n        /// 行動候補の評価値を計算する。\r\n        /// </summary>\r\n        /// <param name=\"context\">意思決定情報</param>\r\n        /// <returns>0から1の行動評価値</returns>\r\n        /// <remarks>\r\n        /// 利用不可能な行動の評価値は0とする。\r\n        /// 評価要素がない場合は基本重みを返す。\r\n        /// </remarks>\r\n        public float Evaluate(TContext context)\r\n        {\r\n            if (Weight <= 0f || !IsAvailable(context))\r\n            {\r\n                return 0f;\r\n            }\r\n\r\n            double score = Weight;\r\n\r\n            for (int i = 0; i < considerations.Length; i++)\r\n            {\r\n                float value =\r\n                    considerations[i].Evaluate(context);\r\n\r\n                // 評価値が0の場合は残りの評価を省略する。\r\n                if (value <= 0f)\r\n                {\r\n                    return 0f;\r\n                }\r\n\r\n                if (UseCompensation)\r\n                {\r\n                    value = UtilityMath.Compensate(\r\n                        value,\r\n                        considerations.Length);\r\n                }\r\n\r\n                score *= value;\r\n            }\r\n\r\n            return UtilityMath.Clamp01((float)score);\r\n        }\r\n    }\r\n}\r\n",
