    "source": "\r\nusing System;\r\nusing Framework.AI.Scheduling;\r\n\r\nnamespace Framework.AI.Core\r\n{\r\n    /// <summary>\r\n    /// 自律型エージェントの基本機能を定義する。\r\n    /// </summary>\r\n    public interface IAgent : IAgentTickable, IDisposable\r\n    {\r\n        /// <summary>\r\n        /// エージェント固有の識別子を取得する。\r\n        /// </summary>\r\n        Guid Id { get; }\r\n\r\n        /// <summary>\r\n        /// エージェントの表示名を取得する。\r\n        /// </summary>\r\n        string Name { get; }\r\n\r\n        /// <summary>\r\n        /// 現在の稼働状態を取得する。\r\n        /// </summary>\r\n        AgentState State { get; }\r\n\r\n        /// <summary>\r\n        /// 初期化済みかどうかを取得する。\r\n        /// </summary>\r\n        bool IsInitialized { get; }\r\n\r\n        /// <summary>\r\n        /// 稼働中かどうかを取得する。\r\n        /// </summary>\r\n        bool IsActive { get; }\r\n\r\n        /// <summary>\r\n        /// 一時停止中かどうかを取得する。\r\n        /// </summary>\r\n        bool IsPaused { get; }\r\n\r\n        /// <summary>\r\n        /// 稼働状態が変更された際に発生する。\r\n        /// 引数は変更前の状態、変更後の状態の順となる。\r\n        /// </summary>\r\n        event Action<AgentState, AgentState> StateChanged;\r\n\r\n        /// <summary>\r\n        /// エージェントを稼働状態にする。\r\n        /// </summary>\r\n        /// <returns>状態変更に成功した場合はtrue</returns>\r\n        bool Activate();\r\n\r\n        /// <summary>\r\n        /// エージェントを非稼働状態にする。\r\n        /// </summary>\r\n        /// <returns>状態変更に成功した場合はtrue</returns>\r\n        bool Deactivate();\r\n\r\n        /// <summary>\r\n        /// エージェントを一時停止する。\r\n        /// </summary>\r\n        /// <returns>状態変更に成功した場合はtrue</returns>\r\n        bool Pause();\r\n\r\n        /// <summary>\r\n        /// 一時停止中のエージェントを再開する。\r\n        /// </summary>\r\n        /// <returns>状態変更に成功した場合はtrue</returns>\r\n        bool Resume();\r\n    }\r\n}\r\n",
