    "source": "using System;\r\nusing Framework.AI.Actions;\r\nusing Framework.Movement;\r\nusing UnityEngine;\r\n\r\nnamespace Game.AI.Actions\r\n{\r\n    /// <summary>\r\n    /// 指定された目的地へ移動する敵AIの共通行動。\r\n    /// </summary>\r\n    /// <remarks>\r\n    /// 巡回、探索、追跡、迎撃、逃走、帰還に使用する。\r\n    /// 行動ごとに独立したインスタンスを生成すること。\r\n    /// </remarks>\r\n    public sealed class MazeEnemyMoveAction\r\n        : IAgentAction<\r\n            MazeEnemyActionType,\r\n            MazeEnemyActionContext>\r\n    {\r\n        /// <summary>\r\n        /// 現在実行している移動の目的地。\r\n        /// </summary>\r\n        private Vector2Int activeDestination;\r\n\r\n        /// <summary>\r\n        /// 有効な経路を設定できているか。\r\n        /// </summary>\r\n        private bool hasActivePath;\r\n\r\n        /// <summary>\r\n        /// 行動の識別子。\r\n        /// </summary>\r\n        public MazeEnemyActionType Id { get; }\r\n\r\n        /// <summary>\r\n        /// 行動の実行設定。\r\n        /// </summary>\r\n        public AgentActionSettings Settings { get; }\r\n\r\n        /// <summary>\r\n        /// 現在の目的地。\r\n        /// </summary>\r\n        public Vector2Int ActiveDestination =>\r\n            activeDestination;\r\n\r\n        /// <summary>\r\n        /// 有効な経路を設定できているか。\r\n        /// </summary>\r\n        public bool HasActivePath =>\r\n            hasActivePath;\r\n\r\n        /// <summary>\r\n        /// 移動行動を生成する。\r\n        /// </summary>\r\n        /// <param name=\"id\">行動の種類</param>\r\n        /// <param name=\"settings\">行動設定</param>\r\n        /// <exception cref=\"ArgumentException\">\r\n        /// 移動行動以外が指定された場合。\r\n        /// </exception>\r\n        public MazeEnemyMoveAction(\r\n            MazeEnemyActionType id,\r\n            AgentActionSettings settings = null)\r\n        {\r\n            if (!MazeEnemyActionContext\r\n                    .IsMovementAction(id))\r\n            {\r\n                throw new ArgumentException(\r\n                    \"移動行動を指定してください。\",\r\n                    nameof(id));\r\n            }\r\n\r\n            Id = id;\r\n\r\n            Settings = settings ??\r\n                new AgentActionSettings(\r\n                    minimumDuration: 0f,\r\n                    cooldown: 0f,\r\n                    canInterrupt: true);\r\n        }\r\n\r\n        /// <summary>\r\n        /// 移動行動を開始可能であるか確認する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動コンテキスト</param>\r\n        /// <returns>開始可能な場合はtrue</returns>\r\n        public bool CanEnter(\r\n            MazeEnemyActionContext context)\r\n        {\r\n            if (context == null ||\r\n                !context.CanAct ||\r\n                context.GetMoveSpeed(Id) <= 0f)\r\n            {\r\n                return false;\r\n            }\r\n\r\n            return context.TryGetDestination(\r\n                       Id, out Vector2Int destination) &&\r\n                   context.Enemy.IsWalkable(destination);\r\n        }\r\n\r\n        /// <summary>\r\n        /// 移動行動を開始する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動コンテキスト</param>\r\n        public void Enter(\r\n            MazeEnemyActionContext context)\r\n        {\r\n            hasActivePath = false;\r\n            activeDestination = default;\r\n\r\n            if (!CanEnter(context))\r\n            {\r\n                return;\r\n            }\r\n\r\n            context.TryGetDestination(\r\n                Id, out Vector2Int destination);\r\n\r\n            context.Movement.MoveSpeed =\r\n                context.GetMoveSpeed(Id);\r\n\r\n            TryApplyDestination(context, destination);\r\n        }\r\n\r\n        /// <summary>\r\n        /// 移動行動を更新する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動コンテキスト</param>\r\n        /// <param name=\"deltaTime\">経過時間</param>\r\n        /// <returns>行動の実行状態</returns>\r\n        public AgentActionStatus Tick(\r\n            MazeEnemyActionContext context,\r\n            float deltaTime)\r\n        {\r\n            if (context == null ||\r\n                !context.IsValid)\r\n            {\r\n                return AgentActionStatus.Failed;\r\n            }\r\n\r\n            // 一時停止中は行動状態を維持する。\r\n            if (!context.CanAct)\r\n            {\r\n                return AgentActionStatus.Running;\r\n            }\r\n\r\n            float speed = context.GetMoveSpeed(Id);\r\n\r\n            if (speed <= 0f)\r\n            {\r\n                return AgentActionStatus.Failed;\r\n            }\r\n\r\n            if (!context.TryGetDestination(\r\n                    Id, out Vector2Int destination) ||\r\n                !context.Enemy.IsWalkable(destination))\r\n            {\r\n                return AgentActionStatus.Failed;\r\n            }\r\n\r\n            // パラメーターの変化を移動速度へ反映する。\r\n            context.Movement.MoveSpeed = speed;\r\n\r\n            // 開始時の経路設定に失敗している場合。\r\n            if (!hasActivePath)\r\n            {\r\n                return AgentActionStatus.Failed;\r\n            }\r\n\r\n            // 目的地が変化した場合のみ経路を再設定する。\r\n            if (destination != activeDestination)\r\n            {\r\n                if (!TryApplyDestination(\r\n                        context, destination))\r\n                {\r\n                    return AgentActionStatus.Failed;\r\n                }\r\n            }\r\n\r\n            switch (context.PathFollower.State)\r\n            {\r\n                case GridPathFollowerState.Following:\r\n                case GridPathFollowerState.Paused:\r\n                    return AgentActionStatus.Running;\r\n\r\n                case GridPathFollowerState.Completed:\r\n                    return AgentActionStatus.Succeeded;\r\n\r\n                case GridPathFollowerState.Failed:\r\n                case GridPathFollowerState.Cancelled:\r\n                case GridPathFollowerState.Idle:\r\n                case GridPathFollowerState.Disposed:\r\n                default:\r\n                    return AgentActionStatus.Failed;\r\n     