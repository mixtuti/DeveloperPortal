    "source": "using Framework.AI.Actions;\r\n\r\nnamespace Game.AI.Actions\r\n{\r\n    /// <summary>\r\n    /// 敵AIを待機させる行動。\r\n    /// </summary>\r\n    public sealed class MazeEnemyIdleAction\r\n        : IAgentAction<\r\n            MazeEnemyActionType,\r\n            MazeEnemyActionContext>\r\n    {\r\n        /// <summary>\r\n        /// 行動の識別子。\r\n        /// </summary>\r\n        public MazeEnemyActionType Id =>\r\n            MazeEnemyActionType.Idle;\r\n\r\n        /// <summary>\r\n        /// 行動の実行設定。\r\n        /// </summary>\r\n        public AgentActionSettings Settings { get; }\r\n\r\n        /// <summary>\r\n        /// 待機行動を生成する。\r\n        /// </summary>\r\n        /// <param name=\"settings\">行動設定</param>\r\n        public MazeEnemyIdleAction(\r\n            AgentActionSettings settings = null)\r\n        {\r\n            Settings = settings ??\r\n                new AgentActionSettings(\r\n                    minimumDuration: 0f,\r\n                    cooldown: 0f,\r\n                    canInterrupt: true);\r\n        }\r\n\r\n        /// <summary>\r\n        /// 待機行動を開始可能であるか確認する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動コンテキスト</param>\r\n        /// <returns>開始可能な場合はtrue</returns>\r\n        public bool CanEnter(\r\n            MazeEnemyActionContext context)\r\n        {\r\n            return context != null &&\r\n                context.CanAct;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 待機行動を開始する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動コンテキスト</param>\r\n        public void Enter(\r\n            MazeEnemyActionContext context)\r\n        {\r\n            context.StopMovement();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 待機行動を更新する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動コンテキスト</param>\r\n        /// <param name=\"deltaTime\">経過時間</param>\r\n        /// <returns>行動の実行状態</returns>\r\n        public AgentActionStatus Tick(\r\n            MazeEnemyActionContext context,\r\n            float deltaTime)\r\n        {\r\n            if (context == null ||\r\n                !context.IsValid)\r\n            {\r\n                return AgentActionStatus.Failed;\r\n            }\r\n\r\n            return AgentActionStatus.Running;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 待機行動を終了する。\r\n        /// </summary>\r\n        /// <param name=\"context\">行動コンテキスト</param>\r\n        /// <param name=\"reason\">終了理由</param>\r\n        public void Exit(\r\n            MazeEnemyActionContext context,\r\n            AgentActionExitReason reason)\r\n        {\r\n            // 待機行動固有の終了処理は不要。\r\n        }\r\n    }\r\n}\r\n",
