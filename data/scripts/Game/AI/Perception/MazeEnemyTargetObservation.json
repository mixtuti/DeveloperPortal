    "source": "\r\nusing System;\r\nusing UnityEngine;\r\n\r\nnamespace Game.AI.Perception\r\n{\r\n    /// <summary>\r\n    /// 敵AIが認識した対象の観測情報。\r\n    /// </summary>\r\n    /// <remarks>\r\n    /// 記憶状態では最後に観測した情報を保持する。\r\n    /// 対象の実際の現在位置は保持しない。\r\n    /// </remarks>\r\n    public readonly struct MazeEnemyTargetObservation\r\n    {\r\n        /// <summary>\r\n        /// 認識対象の一意識別子。\r\n        /// </summary>\r\n        public Guid Id { get; }\r\n\r\n        /// <summary>\r\n        /// 認識対象の種類。\r\n        /// </summary>\r\n        public MazeEnemyTargetType Type { get; }\r\n\r\n        /// <summary>\r\n        /// 対象の認識状態。\r\n        /// </summary>\r\n        public MazeEnemyTargetState State { get; }\r\n\r\n        /// <summary>\r\n        /// 最後に観測したセル座標。\r\n        /// </summary>\r\n        public Vector2Int LastKnownPosition { get; }\r\n\r\n        /// <summary>\r\n        /// 最後に観測した移動方向。\r\n        /// </summary>\r\n        public Vector2Int LastKnownDirection { get; }\r\n\r\n        /// <summary>\r\n        /// 最後に観測した移動速度。\r\n        /// 単位はセル毎秒。\r\n        /// </summary>\r\n        public float LastKnownMoveSpeed { get; }\r\n\r\n        /// <summary>\r\n        /// 最後に対象を観測した時刻。\r\n        /// 単位は秒。\r\n        /// </summary>\r\n        public double LastSeenTime { get; }\r\n\r\n        /// <summary>\r\n        /// 観測情報の信頼度。\r\n        /// 値の範囲は0から1。\r\n        /// </summary>\r\n        public float Confidence { get; }\r\n\r\n        /// <summary>\r\n        /// 対象を視認している状態であるか。\r\n        /// </summary>\r\n        public bool IsVisible =>\r\n            State == MazeEnemyTargetState.Visible;\r\n\r\n        /// <summary>\r\n        /// 対象の情報を記憶している状態であるか。\r\n        /// </summary>\r\n        public bool IsRemembered =>\r\n            State == MazeEnemyTargetState.Remembered;\r\n\r\n        /// <summary>\r\n        /// 有効な観測情報であるか。\r\n        /// </summary>\r\n        public bool IsValid =>\r\n            Id != Guid.Empty &&\r\n            (IsVisible || IsRemembered);\r\n\r\n        /// <summary>\r\n        /// 対象の観測情報を生成する。\r\n        /// </summary>\r\n        /// <param name=\"id\">対象識別子</param>\r\n        /// <param name=\"type\">対象の種類</param>\r\n        /// <param name=\"state\">認識状態</param>\r\n        /// <param name=\"position\">最後の観測座標</param>\r\n        /// <param name=\"direction\">最後の観測移動方向</param>\r\n        /// <param name=\"moveSpeed\">最後の観測移動速度</param>\r\n        /// <param name=\"lastSeenTime\">最後の観測時刻</param>\r\n        /// <param name=\"confidence\">観測情報の信頼度</param>\r\n        internal MazeEnemyTargetObservation(\r\n            Guid id,\r\n            MazeEnemyTargetType type,\r\n            MazeEnemyTargetState state,\r\n            Vector2Int position,\r\n            Vector2Int direction,\r\n            float moveSpeed,\r\n            double lastSeenTime,\r\n            float confidence)\r\n        {\r\n            Id = id;\r\n            Type = type;\r\n            State = state;\r\n\r\n            LastKnownPosition = position;\r\n            LastKnownDirection = direction;\r\n            LastKnownMoveSpeed = moveSpeed;\r\n\r\n            LastSeenTime = lastSeenTime;\r\n            Confidence = Mathf.Clamp01(confidence);\r\n        }\r\n    }\r\n}\r\n",
