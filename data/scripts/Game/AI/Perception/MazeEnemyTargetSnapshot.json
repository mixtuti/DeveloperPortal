    "source": "\r\nusing System;\r\nusing Framework.Movement;\r\nusing UnityEngine;\r\n\r\nnamespace Game.AI.Perception\r\n{\r\n    /// <summary>\r\n    /// 認識判定に使用する対象の現在情報。\r\n    /// </summary>\r\n    /// <remarks>\r\n    /// 認識制御システムへの入力専用データ。\r\n    /// 行動評価側から直接参照しないこと。\r\n    /// </remarks>\r\n    public readonly struct MazeEnemyTargetSnapshot\r\n    {\r\n        /// <summary>\r\n        /// 認識対象の一意識別子。\r\n        /// </summary>\r\n        public Guid Id { get; }\r\n\r\n        /// <summary>\r\n        /// 認識対象の種類。\r\n        /// </summary>\r\n        public MazeEnemyTargetType Type { get; }\r\n\r\n        /// <summary>\r\n        /// 対象の現在セル座標。\r\n        /// </summary>\r\n        public Vector2Int Position { get; }\r\n\r\n        /// <summary>\r\n        /// 対象の現在の移動方向。\r\n        /// 停止中の場合はゼロベクトル。\r\n        /// </summary>\r\n        public Vector2Int Direction { get; }\r\n\r\n        /// <summary>\r\n        /// 対象の現在の移動速度。\r\n        /// 単位はセル毎秒。\r\n        /// </summary>\r\n        public float MoveSpeed { get; }\r\n\r\n        /// <summary>\r\n        /// 対象が認識判定可能な状態であるか。\r\n        /// </summary>\r\n        public bool IsActive { get; }\r\n\r\n        /// <summary>\r\n        /// 有効な対象情報であるか。\r\n        /// </summary>\r\n        public bool IsValid =>\r\n            Id != Guid.Empty &&\r\n            (Type == MazeEnemyTargetType.Player ||\r\n             Type == MazeEnemyTargetType.Threat);\r\n\r\n        /// <summary>\r\n        /// 認識対象の現在情報を生成する。\r\n        /// </summary>\r\n        /// <param name=\"id\">対象の一意識別子</param>\r\n        /// <param name=\"type\">対象の種類</param>\r\n        /// <param name=\"position\">現在セル座標</param>\r\n        /// <param name=\"direction\">現在の移動方向</param>\r\n        /// <param name=\"moveSpeed\">現在の移動速度</param>\r\n        /// <param name=\"isActive\">認識判定可能であるか</param>\r\n        /// <exception cref=\"ArgumentException\">\r\n        /// 識別子、対象種類、移動方向が無効な場合。\r\n        /// </exception>\r\n        /// <exception cref=\"ArgumentOutOfRangeException\">\r\n        /// 移動速度が無効な場合。\r\n        /// </exception>\r\n        public MazeEnemyTargetSnapshot(\r\n            Guid id,\r\n            MazeEnemyTargetType type,\r\n            Vector2Int position,\r\n            Vector2Int direction,\r\n            float moveSpeed,\r\n            bool isActive = true)\r\n        {\r\n            if (id == Guid.Empty)\r\n            {\r\n                throw new ArgumentException(\r\n                    \"対象識別子が無効です。\",\r\n                    nameof(id));\r\n            }\r\n\r\n            if (type != MazeEnemyTargetType.Player &&\r\n                type != MazeEnemyTargetType.Threat)\r\n            {\r\n                throw new ArgumentException(\r\n                    \"認識対象の種類が無効です。\",\r\n                    nameof(type));\r\n            }\r\n\r\n            if (direction != Vector2Int.zero &&\r\n                !GridMovementController\r\n                    .IsCardinalDirection(direction))\r\n            {\r\n                throw new ArgumentException(\r\n                    \"移動方向が無効です。\",\r\n                    nameof(direction));\r\n            }\r\n\r\n            if (float.IsNaN(moveSpeed) ||\r\n                float.IsInfinity(moveSpeed) ||\r\n                moveSpeed < 0f)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(moveSpeed));\r\n            }\r\n\r\n            Id = id;\r\n            Type = type;\r\n            Position = position;\r\n            Direction = direction;\r\n            MoveSpeed = moveSpeed;\r\n            IsActive = isActive;\r\n        }\r\n    }\r\n}\r\n",
