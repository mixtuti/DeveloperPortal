    "source": "using System;\r\nusing System.Collections.Generic;\r\nusing Framework.AI.Actions;\r\nusing Game.AI.Actions;\r\nusing Game.AI.Controllers;\r\n\r\nnamespace Game.AI.Debugging\r\n{\r\n    /// <summary>\r\n    /// 敵AIの行動履歴を記録する。\r\n    /// </summary>\r\n    public sealed class MazeEnemyDebugHistory : IDisposable\r\n    {\r\n        /// <summary>\r\n        /// 行動履歴の最大保持件数。\r\n        /// </summary>\r\n        private readonly int capacity;\r\n\r\n        /// <summary>\r\n        /// 記録済みの行動履歴。\r\n        /// </summary>\r\n        private readonly List<string> entries =\r\n            new List<string>();\r\n\r\n        /// <summary>\r\n        /// 履歴の読み取り専用ビュー。\r\n        /// </summary>\r\n        private readonly IReadOnlyList<string> readOnlyEntries;\r\n\r\n        /// <summary>\r\n        /// 現在の監視対象。\r\n        /// </summary>\r\n        private MazeEnemyController target;\r\n\r\n        /// <summary>\r\n        /// 購読中の行動管理システム。\r\n        /// </summary>\r\n        private AgentActionController<\r\n            MazeEnemyActionType,\r\n            MazeEnemyActionContext> actionController;\r\n\r\n        /// <summary>\r\n        /// 解放済みであるか。\r\n        /// </summary>\r\n        private bool isDisposed;\r\n\r\n        /// <summary>\r\n        /// 記録済みの履歴一覧。\r\n        /// </summary>\r\n        public IReadOnlyList<string> Entries =>\r\n            readOnlyEntries;\r\n\r\n        /// <summary>\r\n        /// 現在の履歴件数。\r\n        /// </summary>\r\n        public int Count => entries.Count;\r\n\r\n        /// <summary>\r\n        /// 最大保持件数。\r\n        /// </summary>\r\n        public int Capacity => capacity;\r\n\r\n        /// <summary>\r\n        /// 履歴管理システムを生成する。\r\n        /// </summary>\r\n        /// <param name=\"capacity\">最大保持件数</param>\r\n        public MazeEnemyDebugHistory(int capacity = 100)\r\n        {\r\n            if (capacity <= 0)\r\n            {\r\n                throw new ArgumentOutOfRangeException(\r\n                    nameof(capacity));\r\n            }\r\n\r\n            this.capacity = capacity;\r\n            readOnlyEntries = entries.AsReadOnly();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 監視対象の敵を設定する。\r\n        /// </summary>\r\n        /// <param name=\"newTarget\">監視対象</param>\r\n        /// <returns>接続に成功した場合はtrue</returns>\r\n        public bool Bind(MazeEnemyController newTarget)\r\n        {\r\n            if (isDisposed)\r\n            {\r\n                return false;\r\n            }\r\n\r\n            var nextController =\r\n                newTarget != null &&\r\n                newTarget.IsInitialized &&\r\n                newTarget.Agent != null\r\n                    ? newTarget.Agent.ActionController\r\n                    : null;\r\n\r\n            // 同じAgentへの重複購読を防止する。\r\n            if (target == newTarget &&\r\n                ReferenceEquals(\r\n                    actionController, nextController) &&\r\n                nextController != null)\r\n            {\r\n                return true;\r\n            }\r\n\r\n            Unbind();\r\n            Clear();\r\n\r\n            if (nextController == null)\r\n            {\r\n                return false;\r\n            }\r\n\r\n            target = newTarget;\r\n            actionController = nextController;\r\n\r\n            actionController.ActionStarted +=\r\n                HandleActionStarted;\r\n\r\n            actionController.ActionEnded +=\r\n                HandleActionEnded;\r\n\r\n            AddEntry(\"監視開始\");\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 行動開始を記録する。\r\n        /// </summary>\r\n        /// <param name=\"action\">開始した行動</param>\r\n        private void HandleActionStarted(\r\n            MazeEnemyActionType action)\r\n        {\r\n            AddEntry($\"開始：{action}\");\r\n        }\r\n\r\n        /// <summary>\r\n        /// 行動終了を記録する。\r\n        /// </summary>\r\n        /// <param name=\"action\">終了した行動</param>\r\n        /// <param name=\"reason\">終了理由</param>\r\n        private void HandleActionEnded(\r\n            MazeEnemyActionType action,\r\n            AgentActionExitReason reason)\r\n        {\r\n            AddEntry($\"終了：{action} / {reason}\");\r\n        }\r\n\r\n        /// <summary>\r\n        /// 履歴を追加する。\r\n        /// </summary>\r\n        /// <param name=\"message\">記録内容</param>\r\n        private void AddEntry(string message)\r\n        {\r\n            double time = 0d;\r\n\r\n            if (target != null &&\r\n                target.EnemyContext != null &&\r\n                target.EnemyContext.StageManager != null)\r\n            {\r\n                time = target.EnemyContext.CurrentTime;\r\n            }\r\n\r\n            // 保持上限を超える場合は最古の履歴を削除する。\r\n            if (entries.Count >= capacity)\r\n            {\r\n                entries.RemoveAt(0);\r\n            }\r\n\r\n            entries.Add($\"[{time:F2}s] {message}\");\r\n        }\r\n\r\n        /// <summary>\r\n        /// 記録済みの履歴を消去する。\r\n        /// </summary>\r\n        public void Clear()\r\n        {\r\n            entries.Clear();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 監視対象との接続を解除する。\r\n        /// </summary>\r\n        public void Unbind()\r\n        {\r\n            if (actionController != null)\r\n            {\r\n                actionController.ActionStarted -=\r\n                    HandleActionStarted;\r\n\r\n                actionController.ActionEnded -=\r\n                    HandleActionEnded;\r\n            }\r\n\r\n            actionController = null;\r\n            target = null;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 所有する資源を解放する。\r\n        /// </summary>\r\n        public void Dispose()\r\n        {\r\n            if (isDisposed)\r\n            {\r\n                return;\r\n            }\r\n\r\n            Unbind();\r\n            Clear();\r\n\r\n            isDisposed = true;\r\n        }\r\n    }\r\n}\r\n",
