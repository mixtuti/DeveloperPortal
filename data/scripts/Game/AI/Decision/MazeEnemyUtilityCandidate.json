    "source": "using Game.AI.Actions;\r\nusing UnityEngine;\r\n\r\nnamespace Game.AI.Decision\r\n{\r\n    /// <summary>\r\n    /// 敵AIの行動候補と評価結果を保持する。\r\n    /// </summary>\r\n    public readonly struct MazeEnemyUtilityCandidate\r\n    {\r\n        /// <summary>\r\n        /// 行動の種類。\r\n        /// </summary>\r\n        public MazeEnemyActionType Action { get; }\r\n\r\n        /// <summary>\r\n        /// 行動の目的地。\r\n        /// </summary>\r\n        public Vector2Int Destination { get; }\r\n\r\n        /// <summary>\r\n        /// 移動目的地を持つ行動であるか。\r\n        /// </summary>\r\n        public bool HasDestination { get; }\r\n\r\n        /// <summary>\r\n        /// 行動の評価値。\r\n        /// 値の範囲は0から1。\r\n        /// </summary>\r\n        public float Score { get; }\r\n\r\n        /// <summary>\r\n        /// 選択可能な行動候補であるか。\r\n        /// </summary>\r\n        public bool IsValid =>\r\n            Action != MazeEnemyActionType.None &&\r\n            Score > 0f;\r\n\r\n        /// <summary>\r\n        /// 行動候補を生成する。\r\n        /// </summary>\r\n        /// <param name=\"action\">行動の種類</param>\r\n        /// <param name=\"destination\">目的地</param>\r\n        /// <param name=\"hasDestination\">目的地の有無</param>\r\n        /// <param name=\"score\">評価値</param>\r\n        public MazeEnemyUtilityCandidate(\r\n            MazeEnemyActionType action,\r\n            Vector2Int destination,\r\n            bool hasDestination,\r\n            float score)\r\n        {\r\n            Action = action;\r\n            Destination = destination;\r\n            HasDestination = hasDestination;\r\n\r\n            Score = float.IsNaN(score)\r\n                ? 0f\r\n                : Mathf.Clamp01(score);\r\n        }\r\n    }\r\n}\r\n",
