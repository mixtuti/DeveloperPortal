    "source": "using UnityEngine;\r\n\r\nnamespace Game.AI.Tactics\r\n{\r\n    /// <summary>\r\n    /// 敵AIによる戦術評価の結果。\r\n    /// </summary>\r\n    public readonly struct MazeEnemyTacticalEvaluation\r\n    {\r\n        /// <summary>\r\n        /// 評価した戦術の種類。\r\n        /// </summary>\r\n        public MazeEnemyTacticalType Type { get; }\r\n\r\n        /// <summary>\r\n        /// 経路探索の開始座標。\r\n        /// </summary>\r\n        public Vector2Int Origin { get; }\r\n\r\n        /// <summary>\r\n        /// 戦術によって選定された目的地。\r\n        /// </summary>\r\n        public Vector2Int Destination { get; }\r\n\r\n        /// <summary>\r\n        /// 最後に認識した対象の座標。\r\n        /// </summary>\r\n        public Vector2Int TargetPosition { get; }\r\n\r\n        /// <summary>\r\n        /// 目的地までの最短経路距離。\r\n        /// 単位はセル数。\r\n        /// </summary>\r\n        public int Distance { get; }\r\n\r\n        /// <summary>\r\n        /// 敵自身が目的地へ到達する予測時間。\r\n        /// 単位は秒。\r\n        /// </summary>\r\n        public float ArrivalTime { get; }\r\n\r\n        /// <summary>\r\n        /// 対象が目的地へ到達する予測時間。\r\n        /// 対象が存在しない場合は0。\r\n        /// </summary>\r\n        public float TargetArrivalTime { get; }\r\n\r\n        /// <summary>\r\n        /// 対象との安全距離。\r\n        /// 単位はセル数。\r\n        /// </summary>\r\n        public int SafetyDistance { get; }\r\n\r\n        /// <summary>\r\n        /// 対象の認識情報の信頼度。\r\n        /// </summary>\r\n        public float Confidence { get; }\r\n\r\n        /// <summary>\r\n        /// 戦術の評価値。\r\n        /// 値の範囲は0から1。\r\n        /// </summary>\r\n        public float Score { get; }\r\n\r\n        /// <summary>\r\n        /// 有効な戦術評価であるか。\r\n        /// </summary>\r\n        public bool IsValid =>\r\n            Type != MazeEnemyTacticalType.None &&\r\n            Distance >= 0;\r\n\r\n        /// <summary>\r\n        /// 戦術評価の結果を生成する。\r\n        /// </summary>\r\n        /// <param name=\"type\">戦術の種類</param>\r\n        /// <param name=\"origin\">探索開始座標</param>\r\n        /// <param name=\"destination\">目的地</param>\r\n        /// <param name=\"targetPosition\">対象の観測座標</param>\r\n        /// <param name=\"distance\">目的地までの距離</param>\r\n        /// <param name=\"arrivalTime\">自身の到達時間</param>\r\n        /// <param name=\"targetArrivalTime\">対象の到達時間</param>\r\n        /// <param name=\"safetyDistance\">対象との安全距離</param>\r\n        /// <param name=\"confidence\">認識信頼度</param>\r\n        /// <param name=\"score\">戦術評価値</param>\r\n        internal MazeEnemyTacticalEvaluation(\r\n            MazeEnemyTacticalType type,\r\n            Vector2Int origin,\r\n            Vector2Int destination,\r\n            Vector2Int targetPosition,\r\n            int distance,\r\n            float arrivalTime,\r\n            float targetArrivalTime,\r\n            int safetyDistance,\r\n            float confidence,\r\n            float score)\r\n        {\r\n            Type = type;\r\n            Origin = origin;\r\n            Destination = destination;\r\n            TargetPosition = targetPosition;\r\n            Distance = distance;\r\n            ArrivalTime = arrivalTime;\r\n            TargetArrivalTime = targetArrivalTime;\r\n            SafetyDistance = safetyDistance;\r\n            Confidence = Mathf.Clamp01(confidence);\r\n            Score = Mathf.Clamp01(score);\r\n        }\r\n    }\r\n}\r\n",
