    "source": "\r\nusing UnityEngine;\r\nusing UnityEngine.Tilemaps;\r\nusing Framework.Grid;\r\nusing Framework.Tilemap;\r\n\r\nnamespace Game.Tests\r\n{\r\n    /// <summary>\r\n    /// 汎用Tilemapレンダラーの動作確認用クラス。\r\n    /// </summary>\r\n    public class GridTilemapRendererTest : MonoBehaviour\r\n    {\r\n        #region Fields\r\n\r\n        [Header(\"マップ設定\")]\r\n\r\n        /// <summary>マップの横方向のマス数。</summary>\r\n        [SerializeField]\r\n        [Min(3)]\r\n        [Tooltip(\"マップの横方向のマス数\")]\r\n        private int width = 15;\r\n\r\n        /// <summary>マップの縦方向のマス数。</summary>\r\n        [SerializeField]\r\n        [Min(3)]\r\n        [Tooltip(\"マップの縦方向のマス数\")]\r\n        private int height = 11;\r\n\r\n        [Header(\"Tilemap設定\")]\r\n\r\n        /// <summary>床を描画するTilemap。</summary>\r\n        [SerializeField]\r\n        [Tooltip(\"床を描画するTilemap\")]\r\n        private Tilemap floorTilemap;\r\n\r\n        /// <summary>壁を描画するTilemap。</summary>\r\n        [SerializeField]\r\n        [Tooltip(\"壁を描画するTilemap\")]\r\n        private Tilemap wallTilemap;\r\n\r\n        [Header(\"タイル設定\")]\r\n\r\n        /// <summary>床として使用するタイル。</summary>\r\n        [SerializeField]\r\n        [Tooltip(\"床として使用するTileアセット\")]\r\n        private TileBase floorTile;\r\n\r\n        /// <summary>壁として使用するタイル。</summary>\r\n        [SerializeField]\r\n        [Tooltip(\"壁として使用するTileアセット\")]\r\n        private TileBase wallTile;\r\n\r\n        [Header(\"テスト設定\")]\r\n\r\n        /// <summary>壁の切り替えテストを行うマス。</summary>\r\n        [SerializeField]\r\n        [Tooltip(\"壁の生成・消去を確認するマスの座標\")]\r\n        private Vector2Int testPosition =\r\n            new Vector2Int(1, 1);\r\n\r\n        /// <summary>床を表すマスデータ。</summary>\r\n        private const int Floor = 0;\r\n\r\n        /// <summary>壁を表すマスデータ。</summary>\r\n        private const int Wall = 1;\r\n\r\n        /// <summary>動作確認用のマップデータ。</summary>\r\n        private GridMap<int> map;\r\n\r\n        /// <summary>動作確認用のTilemapレンダラー。</summary>\r\n        private GridTilemapRenderer<int> mapRenderer;\r\n\r\n        #endregion\r\n\r\n        #region Unity Methods\r\n\r\n        /// <summary>\r\n        /// マップ生成と初期描画を実行する。\r\n        /// </summary>\r\n        private void Start()\r\n        {\r\n            if (!ValidateSettings())\r\n            {\r\n                return;\r\n            }\r\n\r\n            CreateMap();\r\n\r\n            CreateRenderer();\r\n\r\n            mapRenderer.RenderAll();\r\n\r\n            Debug.Log(\r\n                $\"マップ描画完了：{map.Width} × {map.Height}\\n\" +\r\n                $\"登録レイヤー数：{mapRenderer.LayerCount}\",\r\n                this);\r\n        }\r\n\r\n        /// <summary>\r\n        /// コンポーネント破棄時の終了処理。\r\n        /// </summary>\r\n        private void OnDestroy()\r\n        {\r\n            // イベント登録と内部参照を解除する。\r\n            mapRenderer?.Dispose();\r\n\r\n            mapRenderer = null;\r\n        }\r\n\r\n        #endregion\r\n\r\n        #region Initialization\r\n\r\n        /// <summary>\r\n        /// Inspectorの設定内容が有効か確認する。\r\n        /// </summary>\r\n        /// <returns>設定が有効な場合はtrue</returns>\r\n        private bool ValidateSettings()\r\n        {\r\n            if (floorTilemap == null || wallTilemap == null)\r\n            {\r\n                Debug.LogError(\r\n                    \"Tilemapが設定されていません。\",\r\n                    this);\r\n\r\n                return false;\r\n            }\r\n\r\n            if (floorTilemap == wallTilemap)\r\n            {\r\n                Debug.LogError(\r\n                    \"床と壁には異なるTilemapを指定してください。\",\r\n                    this);\r\n\r\n                return false;\r\n            }\r\n\r\n            if (floorTile == null || wallTile == null)\r\n            {\r\n                Debug.LogError(\r\n                    \"床または壁のタイルが設定されていません。\",\r\n                    this);\r\n\r\n                return false;\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 外周と内部の一部に壁を持つマップを生成する。\r\n        /// </summary>\r\n        private void CreateMap()\r\n        {\r\n            map = new GridMap<int>(\r\n                width,\r\n                height,\r\n                position =>\r\n                {\r\n                    // マップの外周に位置するか判定する。\r\n                    bool isBorder =\r\n                        position.x == 0 ||\r\n                        position.y == 0 ||\r\n                        position.x == width - 1 ||\r\n                        position.y == height - 1;\r\n\r\n                    // 外周は壁として設定する。\r\n                    if (isBorder)\r\n                    {\r\n                        return Wall;\r\n                    }\r\n\r\n                    // 内部に一定間隔で壁を配置する。\r\n                    bool isInnerWall =\r\n                        position.x % 2 == 0 &&\r\n                        position.y % 2 == 0;\r\n\r\n                    return isInnerWall ? Wall : Floor;\r\n                });\r\n        }\r\n\r\n        /// <summary>\r\n        /// 描画システムを生成してレイヤーを登録する。\r\n        /// </summary>\r\n        private void CreateRenderer()\r\n        {\r\n            // 自動更新を有効にしてレンダラーを生成する。\r\n            mapRenderer =\r\n                new GridTilemapRenderer<int>(map, true);\r\n\r\n            // 床はすべてのマスに描画する。\r\n            mapRenderer.AddLayer(\r\n                floorTilemap,\r\n                (position, cellData) => floorTile);\r\n\r\n            // 壁は壁データを持つマスにだけ描画する。\r\n            mapRenderer.AddLayer(\r\n                wallTilemap,\r\n                (position, cellData) =>\r\n                    cellData == Wall ? wallTile : null);\r\n        }\r\n\r\n        #endregion\r\n\r\n        #region Test Methods\r\n\r\n        /// <summary>\r\n        /// 指定されたマスの床と壁を切り替える。\r\n        /// マップ変更時の自動描画を確認するために使用する。\r\n        /// </summary>\r\n        [ContextMenu(\"テスト/指定マスの壁を切り替える\")]\r\n        public void ToggleTestCell()\r\n        {\r\n            if (map == null)\r\n            {\r\n                Debug.LogWarning(\r\n                    \"再生モードで実行してください。\",\r\n                    this);\r\n\r\n                return;\r\n            }\r\n\r\n            // 現在のマスデータを取得する。\r\n            if (!map.TryGetCell(\r\n                testPosition,\r\n                out int currentValue))\r\n            {\r\n                Debug.LogWarning(\r\n                    \"テスト座標がマップの範囲外です。\",\r\n                    this);\r\n\r\n                return;\r\n            }\r\n\r\n            // 床と壁を切り替える。\r\n            int newValue =\r\n                currentValue == Wall ? Floor : Wall;\r\n\r\n            // マップデータを変更する。\r\n            // 描画はCellChangedイベントによって更新される。\r\n            map.SetCell(testPosition, newValue);\r\n\r\n            Debug.Log(\r\n                $\"マス変更：{testPosition}\\n\" +\r\n                $\"{currentValue} → {newValue}\",\r\n                this);\r\n        }\r\n\r\n        /// <summary>\r\n        /// マップ全体を再描画する。\r\n        /// </summary>\r\n        [ContextMenu(\"テスト/マップを再描画する\")]\r\n        public void RedrawMap()\r\n        {\r\n            if (mapRenderer == null)\r\n            {\r\n                return;\r\n            }\r\n\r\n            mapRenderer.RenderAll();\r\n\r\n            Debug.Log(\"マップを再描画しました。\", this);\r\n        }\r\n\r\n        /// <summary>\r\n        /// マップの描画内容を消去する。\r\n        /// マップデータ自体は変更しない。\r\n        /// </summary>\r\n        [ContextMenu(\"テスト/マップの描画を消去する\")]\r\n        public void ClearMap()\r\n        {\r\n            if (mapRenderer == null)\r\n            {\r\n                return;\r\n            }\r\n\r\n            mapRenderer.Clear();\r\n\r\n            Debug.Log(\"マップの描画を消去しました。\", this);\r\n        }\r\n\r\n        #endregion\r\n    }\r\n}\r\n",
